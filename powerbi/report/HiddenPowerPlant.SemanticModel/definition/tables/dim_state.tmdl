		sourceColumn: reliance_flag

		annotation SummarizationSetBy = Automatic

	/// State name with a hollow diamond where the tariff is set by a state regulator (NERC rate shown as placeholder, A1), latest month.
	column state_label_tariff =
			VAR _m = CALCULATE ( MAX ( fact_grid_tariff[month] ), REMOVEFILTERS () )
			VAR _ph = CALCULATE ( COUNTROWS ( fact_grid_tariff ), fact_grid_tariff[month] = _m, fact_grid_tariff[tariff_status] <> "nerc_order" )
			RETURN IF ( _ph > 0, dim_state[state] & "  ◇", dim_state[state] )
		lineageTag: f30e839f-0e49-481d-8f95-fdfc311e1f58

	/// Rank in the base priority variant (equal weights, household saving, primary source).
	column priority_rank = CALCULATE ( MAX ( fact_priority_index[rank] ), fact_priority_index[weighting] = "equal", fact_priority_index[gap_user] = "household", fact_priority_index[reliance_measure] = "primary_source" )
		lineageTag: d9e0df57-95ec-4279-b3e8-c6c85804c1e7

	/// 'rank  state' label for the priority bars.
	column priority_label = FORMAT ( dim_state[priority_rank], "0" ) & "  " & dim_state[state]
		lineageTag: 0046585a-d2a0-4358-b22d-abc8d4715319
		sortByColumn: priority_rank

	partition dim_state = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_state.csv"), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"state", type text}, {"zone", type text}, {"discos", type text}, {"tariff_regulator_note", type text}, {"aba_power_note", type text}, {"lon", type number}, {"lat", type number}, {"pvout_annual_mean", type number}, {"pvout_worst_month", type number}, {"mpi_headcount_pct", type number}, {"gen_ownership_pct_hh_nlss", type number}, {"gen_primary_source_pct_hh_nlss", type number}, {"reliance_flag", type text}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

