	measure 'KPI P0 Solar Sub' =
			VAR _v = MEDIANX ( ALL ( dim_state[state] ), [Gen kWh HH Now] )
			RETURN "vs generator " & IF ( _v >= 1000000, "₦" & FORMAT ( _v / 1000000, "0.0" ) & "m", "₦" & FORMAT ( _v, "#,0" ) )
		displayFolder: 0 Overview
		lineageTag: 21ddd2e6-13cc-408d-b117-4ce8a15d858a

	measure 'KPI P0 Payback Value' = FORMAT ( [Payback HH Now], "0.0" ) & " mo"
		displayFolder: 0 Overview
