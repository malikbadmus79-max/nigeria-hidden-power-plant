	measure 'KPI P0 Payback Pill' = "−" & FORMAT ( [Payback HH Peak 2024] - [Payback HH Now], "0.0" ) & " mo"
		displayFolder: 0 Overview
		lineageTag: 5cb4123b-454d-4ffc-be6c-a06fd0529939

	measure 'KPI P0 Payback Sub' = "vs " & [Payback HH Peak Label] & " peak"
		displayFolder: 0 Overview
		lineageTag: 3f612c3b-8d6b-46ca-a78b-ba0380ae66b7

	/// State ranked 1 in the base priority variant.
	measure 'Top Priority State' = MAXX ( TOPN ( 1, ALL ( dim_state[state] ), [Priority Rank], ASC ), dim_state[state] )
		displayFolder: 0 Overview
		lineageTag: 04656175-3979-4051-9077-8a56faeb4f79

	measure 'KPI P0 Top Pill' =
			VAR _s = [Top Priority State]
			VAR _n = CALCULATE ( [Variants In Top 10], dim_state[state] = _s )
			RETURN IF ( _n = [Variants Total], "Top 10 in all " & [Variants Total], "Top 10 in " & _n & " of " & [Variants Total] )
		displayFolder: 0 Overview
