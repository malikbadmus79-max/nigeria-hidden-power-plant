			RETURN "index " & FORMAT ( CALCULATE ( [Priority Index], dim_state[state] = _s ), "0.00" )
		displayFolder: 0 Overview
		lineageTag: bea58a37-0e96-4932-89ec-fe4084e0f8a6

	measure 'Finding 1' =
			VAR _v = [Gen HH Central Now]
			RETURN "Running a small household generator cost a median " & IF ( _v >= 1000000, "₦" & FORMAT ( _v / 1000000, "0.0" ) & "m", "₦" & FORMAT ( _v, "#,0" ) ) & " a month in " & [Latest Month Label] & ", " & FORMAT ( [Gen HH Change] * 100, "0" ) & "% more than in January 2023, after the June 2023 petrol subsidy removal."
		displayFolder: 0 Overview
		lineageTag: cb633f8b-de15-433d-8bbd-041246e78482

	measure 'Finding 2' =
			VAR _g1 = MINX ( ALL ( dim_state[state] ), [Gen kWh HH Now] )
			VAR _g2 = MAXX ( ALL ( dim_state[state] ), [Gen kWh HH Now] )
			VAR _s1 = MINX ( ALL ( dim_state[state] ), [Solar kWh HH Now] )
			VAR _s2 = MAXX ( ALL ( dim_state[state] ), [Solar kWh HH Now] )
			RETURN "Solar + battery costs " & IF ( _s1 >= 1000000, "₦" & FORMAT ( _s1 / 1000000, "0.0" ) & "m", "₦" & FORMAT ( _s1, "#,0" ) ) & "–" & IF ( _s2 >= 1000000, "₦" & FORMAT ( _s2 / 1000000, "0.0" ) & "m", "₦" & FORMAT ( _s2, "#,0" ) ) & " per kWh against " & IF ( _g1 >= 1000000, "₦" & FORMAT ( _g1 / 1000000, "0.0" ) & "m", "₦" & FORMAT ( _g1, "#,0" ) ) & "–" & IF ( _g2 >= 1000000, "₦" & FORMAT ( _g2 / 1000000, "0.0" ) & "m", "₦" & FORMAT ( _g2, "#,0" ) ) & " for a small petrol generator — cheaper in all 37 states."
		displayFolder: 0 Overview
		lineageTag: dfc3aa5b-28eb-43d9-bd9e-84fdf3975e87

	measure 'Finding 3' =
			VAR _t = ADDCOLUMNS ( TOPN ( 3, ALL ( dim_state[state] ), [Priority Rank], ASC ), "@r", [Priority Rank] )
			VAR _n1 = MAXX ( FILTER ( _t, [@r] = 1 ), dim_state[state] )
			VAR _n2 = MAXX ( FILTER ( _t, [@r] = 2 ), dim_state[state] )
			VAR _n3 = MAXX ( FILTER ( _t, [@r] = 3 ), dim_state[state] )
			RETURN "Payback fell from " & FORMAT ( [Payback HH Peak 2024], "0" ) & " months at the " & [Payback HH Peak Label] & " peak to about " & FORMAT ( [Payback HH Now], "0" ) & " months. " & _n1 & ", " & _n2 & " and " & _n3 & " rank highest for market priority."
		displayFolder: 0 Overview
		lineageTag: 86873141-4d47-478d-a034-0d50fe156aca

